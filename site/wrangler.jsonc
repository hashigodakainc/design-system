{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hashigodaka-design-guidelines",
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "design.hashigodaka.co.jp",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
