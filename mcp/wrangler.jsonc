{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hashigodaka-design-system-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "design.hashigodaka.co.jp/mcp*",
      "zone_name": "hashigodaka.co.jp"
    }
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
