{
  "name": "@hashigodaka/design-system-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:snapshot && WRANGLER_LOG_PATH=/tmp/design-system-mcp-wrangler-build.log wrangler deploy --dry-run",
    "build:snapshot": "node --import tsx scripts/build-snapshot.ts",
    "build:wordmark": "node scripts/build-wordmark.mjs",
    "dev": "pnpm build:snapshot && wrangler dev",
    "test": "pnpm validate:tokens && pnpm build:snapshot && node --import tsx --test 'test/**/*.test.ts'",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "typecheck": "pnpm validate:tokens && pnpm build:snapshot && tsc --noEmit",
    "validate:tokens": "node ../scripts/validate-tokens.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "^4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "wrangler": "^4.151.3"
  }
}
